# PostgreSQL connection (Neon, Vercel Postgres, Supabase Postgres, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# NextAuth.js v4 https://next-auth.js.org/configuration/options
# Generate locally: openssl rand -base64 32
NEXTAUTH_SECRET="paste-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Production on Vercel: set DATABASE_URL / NEXTAUTH_SECRET / NEXTAUTH_URL to your HTTPS URL.
